# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

# Enables daily discovery of zero-priced OpenRouter models and live probes.
# Set this in the runtime secrets manager; never commit a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional shared encryption secret for provider account keys across replicas (minimum 32 characters).
# Without this, a local key is generated in .altil-data/provider-vault-key.
ALTIL_PROVIDER_VAULT_KEY=""
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
TOGETHER_API_KEY=your_together_api_key_here

# Required to persist tenant knowledge. Use a unique secret of at least 32 characters.
ALTIL_KNOWLEDGE_ENCRYPTION_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MariaDB connection. For local development, create this database and a dedicated
# application user, then set these values. Never use the MariaDB root account.
MARIADB_HOST="127.0.0.1"
MARIADB_PORT="3306"
MARIADB_USER="altil_user"
MARIADB_PASSWORD=your_mariadb_password_here
MARIADB_DATABASE="altil_db"

# Alternatively set DATABASE_URL and leave the discrete values above unused.
# DATABASE_URL takes precedence when both forms are set. URL-encode special
# characters in the username/password. Example: mysql://user:password@localhost:3306/example_database
# DATABASE_URL=

# Enable only when your database provider requires TLS. For a private CA,
# provide the path to its PEM certificate in MARIADB_SSL_CA.
MARIADB_SSL="false"
# MARIADB_SSL_CA="/path/to/database-ca.pem"
# Optional shared secret for external payment event callbacks (required for signed provider callbacks).
ALTIL_PAYMENT_WEBHOOK_SECRET=
# Optional Stripe hosted checkout. Keep secrets in deployment settings, never frontend code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALTIL_PUBLIC_URL=https://altil.introsoft.com
# Hosted invoice collections (choose provider by request; never store raw card/CVV data).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=
IKHOKHA_API_URL=https://api.ikhokha.com/public-api/v1/api/payment
IKHOKHA_MODE=test

# Optional shared internal Screen Assistant tenant API key (keep secret).
# If unset, ALTIL generates a private local key in .altil-data/internal-ai-api-key.
ALTIL_INTERNAL_AI_API_KEY=
ALTIL_INTERNAL_AI_KEY_FILE=.altil-data/internal-ai-api-key
