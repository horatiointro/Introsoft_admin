# Copy to the ignored .env.docker file. Replace every placeholder locally.
# Never use these values for a shared or production deployment.
COMPOSE_PROJECT_NAME=altil-demo
ALTIL_HOST_PORT=3005
MARIADB_DATABASE=altil_demo
MARIADB_USER=altil_app
MARIADB_PASSWORD=replace_with_a_unique_local_demo_password
MARIADB_ROOT_PASSWORD=replace_with_a_different_unique_local_root_password
ALTIL_TEST_ADMIN_CONFIRM_DATABASE=altil_demo
ALTIL_TEST_ADMIN_CONFIRM_HOST=mariadb
ALTIL_TEST_SUPER_ADMIN_001_PASSWORD=replace_with_requested_test_password_001
ALTIL_TEST_SUPER_ADMIN_002_PASSWORD=replace_with_requested_test_password_002
# Fixed MFA code is a development-test fixture for the two named test accounts only.
# This is not a real second factor and must never be enabled in production.
ALTIL_TEST_MFA_CODE=000000
